# Copy to .env and fill in. Loaded in development/test by dotenv-rails.
# Names only: never commit real values. Production secrets go in `fly secrets`.

# AI providers. Keys stay server-side and are never stored in the database.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
# Default dialogue model, copied into the live configuration on first seed.
LLM_MODEL=gpt-5.6-luna
# Per-request provider timeouts in milliseconds.
LLM_TIMEOUT_MS=30000
STT_TIMEOUT_MS=15000
TTS_TIMEOUT_MS=20000
# Threads available for concurrent dialogue generation inside each Puma process.
# GENERATION_THREADS=4

# Public URL of this deployment (mail links, Action Cable origin check).
APP_URL=http://localhost:3000
# Comma-separated extra origins allowed to open the WebSocket in production.
# ACTION_CABLE_ALLOWED_ORIGINS=

# Initial admin account, created by `bin/rails db:seed`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Signup is disabled in production unless this is "true".
# ALLOW_SIGNUP=

# Site-wide password gate, asked once per browser session and independent from
# user sign-in. Leave unset/blank to disable the gate entirely.
# PASSWORD=

# Action Mailer
MAILER_SENDER=no-reply@example.com

# S3-compatible storage for Active Storage (avatars in production).
# Plain AWS S3: set AWS_BUCKET and leave AWS_ENDPOINT_URL_S3 unset.
# Other providers (Tigris, R2, MinIO, …) need the endpoint, and some inject
# BUCKET_NAME instead of AWS_BUCKET.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET=
# AWS_ENDPOINT_URL_S3=
# BUCKET_NAME=

# Active Record connection pool. Defaults to RAILS_MAX_THREADS when unset; set
# it higher than RAILS_MAX_THREADS when Solid Queue workers share the pool.
# DB_POOL=
